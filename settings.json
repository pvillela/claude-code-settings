{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./clippy.sh *)",
      "Bash(./check.sh *)",
      "Bash(./check-features.sh *)",
      "Bash(cargo check *)",
      "Bash(./test.sh *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(echo \"=== exit: $?\")",
      "Bash(grep *)",
      "Bash(npx markdownlint *)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Read(.env)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/rustfmt-on-edit.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell"
}